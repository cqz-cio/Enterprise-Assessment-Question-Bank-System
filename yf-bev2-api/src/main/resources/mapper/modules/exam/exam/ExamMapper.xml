<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yf.modules.exam.exam.mapper.ExamMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yf.modules.exam.exam.dto.ExamDTO">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="open_type" property="openType"/>
        <result column="state" property="state"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="total_score" property="totalScore"/>
        <result column="total_time" property="totalTime"/>
        <result column="qualify_score" property="qualifyScore"/>
        <result column="chance" property="chance"/>
        <result column="hand_min" property="handMin"/>
        <result column="late_max" property="lateMax"/>
        <result column="thanks" property="thanks"/>
        <result column="repo_id" property="repoId"/>
        <result column="depart_id" property="departId"/>
        <result column="position_id" property="positionId"/>
        <result column="scene_type" property="sceneType"/>
        <result column="target_grade_id" property="targetGradeId"/>
        <result column="template_status" property="templateStatus"/>
        <result column="option_shuffle" property="optionShuffle"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
    </resultMap>


    <select id="paging" resultMap="BaseResultMap">
        SELECT * FROM el_exam ee
        <where>
            <if test="query!=null">
                <if test="query.title!=null and query.title!=''">
                    AND ee.title LIKE CONCAT('%', #{query.title}, '%')
                </if>
                <if test="query.startTimeL!=null">
                    AND ee.start_time >= #{query.startTimeL}
                </if>

                <if test="query.startTimeR!=null">
                    AND ee.end_time &lt;= #{query.startTimeR}
                </if>
                <if test="query.positionId!=null and query.positionId!=''">
                    AND ee.position_id = #{query.positionId}
                </if>
                <if test="query.departId!=null and query.departId!=''">
                    AND ee.depart_id = #{query.departId}
                </if>
                <if test="query.sceneType!=null and query.sceneType!=''">
                    AND ee.scene_type = #{query.sceneType}
                </if>
                <if test="query.targetGradeId!=null and query.targetGradeId!=''">
                    AND ee.target_grade_id = #{query.targetGradeId}
                </if>
                <if test="query.templateStatus!=null">
                    AND ee.template_status = #{query.templateStatus}
                </if>
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>
