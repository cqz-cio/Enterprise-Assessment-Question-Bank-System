# Copy privately to secrets/app.env and replace every placeholder.
# This test deployment uses fresh, independent secrets. Old copied access codes
# do not authenticate here; issue new test assignments. Never rotate keys on restart.
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18082
EXAM_DB_URL=jdbc:mysql://127.0.0.1:13307/enterprise_exam_test?useSSL=false&serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&allowPublicKeyRetrieval=true
EXAM_DB_USER=exam_app
EXAM_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
EXAM_REDIS_HOST=127.0.0.1
EXAM_REDIS_PORT=16380
EXAM_REDIS_DATABASE=0
EXAM_REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
JWT_SECRET=GENERATE_ONCE_AND_KEEP_PRIVATE
ASSIGNMENT_CODE_PEPPER=GENERATE_ANOTHER_INDEPENDENT_SECRET_ONCE
EXAM_LOG_FILE=/opt/enterprise-exam-test/logs/exam.log
LOGGING_CONFIG=/opt/enterprise-exam-test/logback-spring.xml
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SERVER_TOMCAT_THREADS_MAX=40
SERVER_FORWARD_HEADERS_STRATEGY=native
# This backend listens on loopback only, directly behind host Nginx.
SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=127\.0\.0\.1
SERVER_TOMCAT_REMOTEIP_REMOTE_IP_HEADER=X-Forwarded-For
SERVER_TOMCAT_REMOTEIP_PROTOCOL_HEADER=X-Forwarded-Proto
