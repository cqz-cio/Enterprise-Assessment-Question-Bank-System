[Unit]
Description=Enterprise assessment test application
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=exam-test
Group=exam-test
WorkingDirectory=/opt/enterprise-exam-test
EnvironmentFile=/opt/enterprise-exam-test/secrets/app.env
ExecStart=/usr/lib/jvm/java-17-openjdk-amd64/bin/java -Xms128m -Xmx320m -XX:MaxMetaspaceSize=192m -XX:MaxDirectMemorySize=64m -Xss512k -jar /opt/enterprise-exam-test/current.jar
Restart=on-failure
RestartSec=10
TimeoutStopSec=40
SuccessExitStatus=143
MemoryMax=700M
CPUQuota=100%
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/enterprise-exam-test/uploads /opt/enterprise-exam-test/logs
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
